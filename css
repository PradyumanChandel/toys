@property --bg-1 { syntax: "<color>"; inherits: true; initial-value: #0b1d3a; }
@property --bg-2 { syntax: "<color>"; inherits: true; initial-value: #15386b; }
@property --accent { syntax: "<color>"; inherits: true; initial-value: #4da3ff; }

:root {
  transition: --bg-1 1s var(--ease), --bg-2 1s var(--ease), --accent 1s var(--ease);
  --bg-1: #0b1d3a;
  --bg-2: #15386b;
  --accent: #4da3ff;
  --text: #ffffff;
  --muted: rgba(255, 255, 255, 0.72);
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--text);
  background: #05070d;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
button { font: inherit; cursor: pointer; border: none; }

.container { width: min(1180px, 92%); margin: 0 auto; }

/* ---------- NAV ---------- */
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 5%;
  transition: background 0.4s var(--ease), backdrop-filter 0.4s var(--ease), padding 0.4s var(--ease);
}
.nav.scrolled {
  background: rgba(5, 7, 13, 0.7);
  backdrop-filter: blur(14px);
  padding: 12px 5%;
}
.logo { font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em; }
.logo span { color: var(--accent); margin-left: 4px; }
.nav-links { display: flex; gap: 28px; }
.nav-links a { font-size: 0.92rem; color: var(--muted); transition: color 0.3s; }
.nav-links a:hover { color: #fff; }
.nav-cta {
  padding: 10px 20px;
  border-radius: 999px;
  background: #fff;
  color: #0b0b0b;
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform 0.3s var(--ease);
}
.nav-cta:hover { transform: translateY(-2px); }

/* ---------- HERO ---------- */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 5% 90px;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: -10%;
  z-index: -1;
  background:
    radial-gradient(circle at 70% 40%, var(--bg-2), transparent 60%),
    linear-gradient(160deg, var(--bg-1), #03060c 80%);
  transition: background 1s var(--ease);
  will-change: transform;
}

.hero-inner {
  width: min(1180px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  align-items: center;
  gap: 40px;
  flex: 1;
}

.eyebrow {
  display: inline-block;
  font-size: 0.8rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 18px;
  transition: color 0.8s var(--ease);
}

.hero-title {
  font-size: clamp(2.6rem, 6vw, 4.6rem);
  line-height: 1.02;
  letter-spacing: -0.03em;
  font-weight: 800;
  margin-bottom: 20px;
}

.hero-desc {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--muted);
  max-width: 460px;
  margin-bottom: 28px;
}

.price-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 30px; }
.price { font-size: 2.2rem; font-weight: 800; }
.old-price { font-size: 1.1rem; color: rgba(255,255,255,0.45); text-decoration: line-through; }

.hero-actions { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 15px 28px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 0.98rem;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), background 0.8s var(--ease);
}
.btn-primary {
  background: var(--accent);
  color: #03101f;
  box-shadow: 0 14px 40px -12px var(--accent);
}
.btn-primary:hover { transform: translateY(-3px) scale(1.02); }

.hero-meta { display: flex; gap: 22px; font-size: 0.88rem; color: var(--muted); }

/* Stage + car stack */
.hero-stage {
  position: relative;
  width: min(520px, 100%);
  justify-self: center;
  aspect-ratio: 1;
}
.stage-glow {
  position: absolute;
  width: 70%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent) 0%, transparent 65%);
  opacity: 0.25;
  filter: blur(40px);
  transition: background 0.9s var(--ease);
}
.car-stack {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 32px;
  overflow: hidden;
  z-index: 1;
}
.car-stack img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 32px;
  box-shadow: 0 40px 80px -30px rgba(0,0,0,0.6);
  opacity: 0;
  transform: translateX(120px) scale(0.9) rotate(3deg);
  transition: opacity 0.7s var(--ease), transform 0.9s var(--ease);
  pointer-events: none;
}
.car-stack img.active {
  opacity: 1;
  transform: translateX(0) scale(1) rotate(0);
}
.car-stack img.prev {
  opacity: 0;
  transform: translateX(-120px) scale(0.85) rotate(-4deg);
}

/* Text swap animation */
.swap-out { opacity: 0; transform: translateY(12px); }
.hero-text > * { transition: opacity 0.4s var(--ease), transform 0.4s var(--ease); }

/* Selector */
.selector {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}
.pill {
  padding: 11px 22px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 500;
  border: 1px solid rgba(255,255,255,0.12);
  transition: all 0.4s var(--ease);
}
.pill:hover { color: #fff; transform: translateY(-2px); }
.pill.active {
  background: #fff;
  color: #0b0b0b;
  border-color: #fff;
  box-shadow: 0 10px 30px -8px rgba(255,255,255,0.5);
}

.scroll-hint {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.scroll-hint span {
  width: 1px;
  height: 36px;
  background: linear-gradient(to bottom, var(--accent), transparent);
  animation: drip 1.8s infinite;
}
@keyframes drip {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

/* ---------- SHOWCASE (pinned scroll) ---------- */
.showcase {
  position: relative;
  height: 260vh;
  background: #05070d;
}
.showcase-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
  width: min(1180px, 92%);
  margin: 0 auto;
  overflow: hidden;
}
.showcase-car {
  display: flex;
  justify-content: center;
  will-change: transform;
}
.showcase-car img {
  width: 100%;
  max-width: 520px;
  border-radius: 24px;
  object-fit: cover;
  aspect-ratio: 1;
  transition: transform 0.2s linear;
}
.showcase-copy .section-title { margin-bottom: 14px; }
.showcase-copy .section-desc { margin-bottom: 28px; }

.progress {
  width: 100%;
  max-width: 360px;
  height: 3px;
  background: rgba(255,255,255,0.12);
  border-radius: 99px;
  overflow: hidden;
}
.progress span {
  display: block;
  width: 0%;
  height: 100%;
  background: var(--accent);
  transition: width 0.15s linear, background 0.8s var(--ease);
}

/* ---------- SECTIONS ---------- */
.section-title {
  font-size: clamp(2rem, 4.4vw, 3.2rem);
  letter-spacing: -0.025em;
  line-height: 1.1;
  font-weight: 800;
  margin-bottom: 14px;
}
.section-desc { color: var(--muted); font-size: 1.02rem; line-height: 1.6; max-width: 520px; }

/* ---------- LINEUP ---------- */
.lineup, .features { padding: 130px 0; background: #05070d; }
.lineup-grid {
  margin-top: 56px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 22px;
}
.card {
  background: linear-gradient(180deg, #111826, #0a0e17);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 22px;
  padding: 18px 18px 22px;
  transition: transform 0.5s var(--ease), border-color 0.5s var(--ease), box-shadow 0.5s var(--ease);
}
.card:hover {
  transform: translateY(-8px);
  border-color: var(--accent);
  box-shadow: 0 30px 60px -25px rgba(0,0,0,0.8);
}
.card-img {
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 18px;
  aspect-ratio: 1;
  background: #fff;
}
.card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s var(--ease);
}
.card:hover .card-img img { transform: scale(1.06); }
.card h3 { font-size: 1.1rem; margin-bottom: 6px; }
.card p { color: var(--muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 18px; min-height: 40px; }
.card-foot { display: flex; justify-content: space-between; align-items: center; }
.card-foot strong { font-size: 1.05rem; }
.card-btn {
  padding: 9px 18px;
  border-radius: 999px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  transition: background 0.3s, color 0.3s;
}
.card-btn:hover { background: var(--accent); color: #03101f; }

/* ---------- FEATURES ---------- */
.feature-grid {
  margin-top: 56px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 22px;
}
.feature {
  padding: 34px 30px;
  border-radius: 22px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
}
.feature-num {
  font-size: 0.85rem;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 26px;
  letter-spacing: 0.1em;
}
.feature h3 { font-size: 1.3rem; margin-bottom: 10px; }
.feature p { color: var(--muted); line-height: 1.6; font-size: 0.95rem; }

/* ---------- CTA + FOOTER ---------- */
.cta { padding: 120px 0; text-align: center; }
.cta-inner { display: flex; flex-direction: column; align-items: center; }
.cta-inner .section-desc { margin-bottom: 30px; }
.cta .btn-primary { background: #fff; color: #0b0b0b; box-shadow: none; }

.footer {
  padding: 30px;
  text-align: center;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.4);
  border-top: 1px solid rgba(255,255,255,0.06);
}

/* ---------- REVEAL ON SCROLL ---------- */
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
}
.reveal.in-view { opacity: 1; transform: translateY(0); }
.feature.reveal:nth-child(2) { transition-delay: 0.12s; }
.feature.reveal:nth-child(3) { transition-delay: 0.24s; }
.card.reveal:nth-child(2) { transition-delay: 0.1s; }
.card.reveal:nth-child(3) { transition-delay: 0.2s; }
.card.reveal:nth-child(4) { transition-delay: 0.3s; }

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; text-align: center; }
  .hero-desc { margin-left: auto; margin-right: auto; }
  .hero-actions { align-items: center; }
  .price-row { justify-content: center; }
  .hero-stage { width: min(440px, 100%); }
  .nav-links { display: none; }
  .showcase-sticky { grid-template-columns: 1fr; text-align: center; gap: 20px; }
  .showcase-copy { display: flex; flex-direction: column; align-items: center; }
  .progress { max-width: none; width: 80%; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .reveal { opacity: 1; transform: none; }
  html { scroll-behavior: auto; }
}

